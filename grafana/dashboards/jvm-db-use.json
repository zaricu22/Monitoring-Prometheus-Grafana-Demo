    {
      "type": "timeseries",
      "title": "Connections",
      "description": "Pool size is 5 on purpose. Enable DB chaos (dbLatencyMs) to see 'pending' rise.",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_active{application=~\"$application\", instance=~\"$instance\"})",
          "legendFormat": "active (utilization)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_idle{application=~\"$application\", instance=~\"$instance\"})",
          "legendFormat": "idle",
          "refId": "B"
        },
        {
