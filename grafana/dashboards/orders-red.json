            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_sum{application=~\"$application\", instance=~\"$instance\", uri=~\"$uri\", uri!~\"/actuator.*\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{application=~\"$application\", instance=~\"$instance\", uri=~\"$uri\", uri!~\"/actuator.*\"}[$__rate_interval]))",
