    {
      "type": "heatmap",
      "title": "Latency distribution (heatmap)",
      "description": "Each column is one time slice; each cell is how many requests fell into that latency bucket. Shows bimodal behaviour that percentiles hide.",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
